From d5740e8577159cf48283e1bb1b6f5bbd9d4efa0b Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Murat=20Du=C4=9Fan?=
 <111883464+MuratDugan@users.noreply.github.com>
Date: Sun, 22 Nov 2026 01:54:22 +0300
Subject: [PATCH] holepunch: fix state_mutex unlock imbalance in session_start

chiaki_holepunch_session_start() unlocks state_mutex at the end of every
loop iteration and again after the loop, so the normal exit unlocks a
mutex that is not locked. glibc tolerates that; other pthread
implementations do not. On Native Client's newlib the mutex state goes
to -1 and the next lock (the first thing
chiaki_holepunch_session_punch_hole() does) blocks forever.

The cancel path had the opposite problem: it returned from inside the
loop with state_mutex still held.

Unlock after the loop only when the loop was left through a break, and
make the cancel path break instead of return.
---
 lib/src/remote/holepunch.c | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/lib/src/remote/holepunch.c b/lib/src/remote/holepunch.c
index d5104d1..6766ca3 100644
--- a/lib/src/remote/holepunch.c
+++ b/lib/src/remote/holepunch.c
@@ -1261,7 +1261,7 @@ CHIAKI_EXPORT ChiakiErrorCode chiaki_holepunch_session_start(
             chiaki_mutex_unlock(&session->stop_mutex);
             CHIAKI_LOGI(session->log, "chiaki_holepunch_session_start: canceled");
             err = CHIAKI_ERR_CANCELED;
-            return err;
+            break;
         }
         chiaki_mutex_unlock(&session->stop_mutex);
         http_check_session(session, false);
@@ -1270,7 +1270,9 @@ CHIAKI_EXPORT ChiakiErrorCode chiaki_holepunch_session_start(
         log_session_state(session);
         chiaki_mutex_unlock(&session->state_mutex);
     }
-    chiaki_mutex_unlock(&session->state_mutex);
+    // The loop is left with state_mutex held only through one of the breaks above.
+    if(!finished)
+        chiaki_mutex_unlock(&session->state_mutex);
     return err;
 }
 
